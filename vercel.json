{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "includeFiles": "{domain.mjs,seed.mjs,supabase-handler.mjs,collaboration-handler.mjs,personalization-handler.mjs,suite-handler.mjs,suite-domain.mjs,collaboration-extra-handler.mjs,copilot-handler.mjs,webchat-handler.mjs}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=:path*"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
