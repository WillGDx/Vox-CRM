# Configure these runtime variables in the Vercel project.
# Both values come from the Supabase project settings.
# Use a publishable key or the legacy anon key; never use service_role/secret keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional OpenAI integration. Server only; never use a VITE_ prefix.
# Set the key in Vercel Environment Variables and redeploy.
# The existing deployment also accepts KeyChatGPT as a legacy variable name.
# API billing/credits are separate from ChatGPT subscriptions.
# VOX_AI_API_KEY=
# VOX_AI_MODEL=gpt-4.1-mini
# VOX_AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
